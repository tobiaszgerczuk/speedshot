{% set subpage = true %}
{% extends "base.twig" %}

{% block content %}
  <article class="subpage">

    {% set hero_image = post.thumbnail.src %}
    {% set hero_subtitle = post.excerpt %}
    {% include "partials/page-hero.twig" %}

    <section class="subpage-content">
      {{ post.content }}
    </section>

  </article>
{% endblock %}
