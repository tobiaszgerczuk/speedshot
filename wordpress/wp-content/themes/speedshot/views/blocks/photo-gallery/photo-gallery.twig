{% if images %}
<section{% if section_id %} id="{{ section_id }}"{% endif %} class="{{ section_classes }}"{% if section_style %} style="{{ section_style }}"{% endif %}
  data-gallery>
  <div class="container">
    <div class="block-photo-gallery__grid block-photo-gallery__grid--cols-{{ columns }}">
      {% for image in images %}
        <button class="block-photo-gallery__item"
                data-gallery-open="{{ loop.index0 }}"
                aria-label="Otwórz zdjęcie {{ loop.index }}"
                data-reveal="up" data-reveal-delay="{{ loop.index0 * 50 }}" data-reveal-duration="600">
          <img class="block-photo-gallery__thumb"
               src="{{ image.thumb }}"
               alt="{{ image.alt }}"
               loading="lazy">
          <span class="block-photo-gallery__zoom" aria-hidden="true">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          </span>
        </button>
      {% endfor %}
    </div>
  </div>

  {# Lightbox #}
  <div class="block-photo-gallery__lightbox" data-gallery-lightbox aria-hidden="true" role="dialog" aria-modal="true">
    <div class="block-photo-gallery__lightbox-backdrop" data-gallery-close></div>
    <button class="block-photo-gallery__lightbox-close" data-gallery-close aria-label="Zamknij">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="block-photo-gallery__lightbox-arrow block-photo-gallery__lightbox-arrow--prev" data-gallery-prev aria-label="Poprzednie">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="block-photo-gallery__lightbox-stage">
      <img class="block-photo-gallery__lightbox-img" src="" alt="" data-gallery-img>
    </div>
    <button class="block-photo-gallery__lightbox-arrow block-photo-gallery__lightbox-arrow--next" data-gallery-next aria-label="Następne">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <p class="block-photo-gallery__lightbox-counter" data-gallery-counter></p>
  </div>

  {# Dane zdjęć dla JS #}
  <script type="application/json" data-gallery-data>
    {{ images|json_encode|raw }}
  </script>
</section>
{% elseif is_preview %}
  <div class="block-photo-gallery__placeholder">Dodaj zdjęcia w ustawieniach bloku.</div>
{% endif %}
