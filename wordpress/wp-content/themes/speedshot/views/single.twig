{% extends "base.twig" %}

{% block content %}
  <article class="single-post">

    {% set hero_image = post.thumbnail.src %}
    {% set hero_subtitle = post.preview.length(28) %}
    {% include "partials/page-hero.twig" %}

    <div class="single-post__content-wrap">
      <div class="container-medium">
        <div class="single-post__content content">{{ post.content }}</div>
      </div>
    </div>

    <footer class="single-post__footer">
      <div class="container-medium">
        <div class="single-post__back">
          <a href="{{ function('get_post_type_archive_link', post.post_type) ?: function('home_url', '/') }}">← Wróć</a>
        </div>
      </div>
    </footer>

  </article>
{% endblock %}
