{% extends "base.twig" %}

{% block content %}
  {% set hero_title = archive_title %}
  {% set hero_subtitle = archive_description|striptags %}
  {% include "partials/page-hero.twig" %}

  <section class="archive-listing">
    <div class="container">
      {% if posts %}
        <div class="post-grid">
          {% for post in posts %}
            <article class="post-card">
              <a class="post-card__media" href="{{ post.link }}">
                {% if post.thumbnail %}
                  {{ wco_image(post.thumbnail, {
                    size: 'large',
                    loading: 'lazy',
                    alt: post.thumbnail.alt ?: post.title,
                    class: 'post-card__media-image'
                  })|raw }}
                {% else %}
                  <span class="post-card__placeholder">Brak zdjęcia</span>
                {% endif %}
              </a>

              <div class="post-card__body">
                <div class="post-card__meta">
                  <time datetime="{{ post.date('c') }}">{{ post.date('d.m.Y') }}</time>
                  {% if post.terms('category') %}
                    <span>{{ post.terms('category')|first.name }}</span>
                  {% endif %}
                </div>

                <h2 class="post-card__title">
                  <a href="{{ post.link }}">{{ post.title }}</a>
                </h2>

                <p class="post-card__excerpt">{{ post.preview.length(28) }}</p>

                <a class="post-card__link" href="{{ post.link }}">Czytaj więcej</a>
              </div>
            </article>
          {% endfor %}
        </div>

        {% if posts.pagination.pages %}
          <nav class="pagination" aria-label="Nawigacja wpisów">
            {% if posts.pagination.prev %}
              <a class="pagination__link pagination__link--prev" href="{{ posts.pagination.prev.link }}">Poprzednia</a>
            {% endif %}

            {% for page in posts.pagination.pages %}
              {% if page.link %}
                <a class="pagination__link {{ page.current ? 'is-current' : '' }}" href="{{ page.link }}">{{ page.title }}</a>
              {% else %}
                <span class="pagination__link pagination__link--dots">{{ page.title }}</span>
              {% endif %}
            {% endfor %}

            {% if posts.pagination.next %}
              <a class="pagination__link pagination__link--next" href="{{ posts.pagination.next.link }}">Następna</a>
            {% endif %}
          </nav>
        {% endif %}
      {% else %}
        <div class="empty-state">
          <h2>Brak wpisów.</h2>
          <p>Tutaj jeszcze nic nie ma.</p>
        </div>
      {% endif %}
    </div>
  </section>
{% endblock %}
