.DS_Store

# Local environment overrides
.env
.env.local
.env.*.local

# Ignore everything in WordPress by default
/wordpress/*

# Keep wp-content available for tracked custom code
!/wordpress/wp-content/
/wordpress/wp-content/*

# Ignore installed plugins and uploads by default
/wordpress/wp-content/plugins/
/wordpress/wp-content/uploads/

# Ignore all themes except the active project theme
!/wordpress/wp-content/themes/
/wordpress/wp-content/themes/*
!/wordpress/wp-content/themes/speedshot/
!/wordpress/wp-content/themes/speedshot/**

# Ignore nested repository metadata and installed dependencies
**/.git/
**/.DS_Store
**/node_modules/
**/vendor/
